SENTRY_AUTH_TOKEN=              # only needed in CI/prod builds, to upload source maps

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=              # e.g. "Najah.ma <no-reply@najah.ma>" — requires a verified domain in Resend.
