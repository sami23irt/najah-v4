# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-only, never expose to the client
DATABASE_URL=                    # Supabase Postgres connection string, for drizzle-kit

# LiveKit (Cloud project or self-hosted)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Gemini (generation + embeddings; RAG uses gemini-embedding-001 at 768 dimensions)
GEMINI_API_KEY=

# Sentry (error tracking — org "iratta", project "najah-ma")
